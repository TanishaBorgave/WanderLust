<% layout("/layouts/boilerplate") %>
    <!-- <h3>All Listings</h3> -->
<div class="row align-items-center mt-3">
<div class ='col-8'>
    <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
        <p class="text-muted mb-2">Showing results for "<%= searchQuery %>"</p>
    <% } %>
<div id="filters">
    <a href="/listings?category=Trending" class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </a>

    <a href="/listings?category=Rooms" class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </a>

    <a href="/listings?category=Beach" class="filter">
        <div><i class="fa-solid fa-umbrella-beach"></i></div>
        <p>Beach</p>
    </a>

    <a href="/listings?category=Amazing Pools" class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </a>

    <a href="/listings?category=Cabins" class="filter">
        <div><i class="fa-solid fa-house-chimney"></i></div>
        <p>Cabins</p>
    </a>

    <a href="/listings?category=Mountains" class="filter">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </a>

    <a href="/listings?category=Arctic" class="filter">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </a>

    <a href="/listings?category=Camping" class="filter">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </a>

    <a href="/listings?category=City" class="filter">
        <div><i class="fa-solid fa-city"></i></div>
        <p>City</p>
    </a>

    <a href="/listings?category=Forest" class="filter">
        <div><i class="fa-solid fa-tree"></i></div>
        <p>Forest</p>
    </a>

    <a href="/listings?category=Lakefront" class="filter">
        <div><i class="fa-solid fa-water"></i></div>
        <p>Lakefront</p>
    </a>

    <a href="/listings?category=Boats" class="filter">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
    </a>

    <a href="/listings?category=Luxury" class="filter">
        <div><i class="fa-solid fa-hotel"></i></div>
        <p>Luxury</p>
    </a>

    <a href="/listings?category=Family" class="filter">
        <div><i class="fa-solid fa-people-roof"></i></div>
        <p>Family</p>
    </a>

    <a href="/listings?category=Pet Friendly" class="filter">
        <div><i class="fa-solid fa-paw"></i></div>
        <p>Pet Friendly</p>
    </a>

    <a href="/listings?category=Free WiFi" class="filter">
        <div><i class="fa-solid fa-wifi"></i></div>
        <p>Free WiFi</p>
    </a>

    <a href="/listings?category=Gym" class="filter">
        <div><i class="fa-solid fa-dumbbell"></i></div>
        <p>Gym</p>
    </a>

    <a href="/listings?category=Spa" class="filter">
        <div><i class="fa-solid fa-spa"></i></div>
        <p>Spa</p>
    </a>

    <a href="/listings?category=Kitchen" class="filter">
        <div><i class="fa-solid fa-utensils"></i></div>
        <p>Kitchen</p>
    </a>

    <a href="/listings?category=Parking" class="filter">
        <div><i class="fa-solid fa-car"></i></div>
        <p>Parking</p>
    </a>
    </div>
</div>
<div class="col-4 d-flex justify-content-end align-items-center gap-3">

    <div class="dropdown">
        <button class="btn btn-outline-dark dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-solid fa-sliders"></i> Filters
        </button>
        <ul class="dropdown-menu dropdown-menu-end filter-menu">
            <li class="dropdown-header px-3">Price</li>
            <li><a class="dropdown-item <%= !selectedPrice || selectedPrice === 'all' ? 'active' : '' %>" href="/listings">All prices</a></li>
            <li><a class="dropdown-item <%= selectedPrice === 'budget' ? 'active' : '' %>" href="/listings?price=budget">Under ₹3,000</a></li>
            <li><a class="dropdown-item <%= selectedPrice === 'standard' ? 'active' : '' %>" href="/listings?price=standard">₹3,000 - ₹7,000</a></li>
            <li><a class="dropdown-item <%= selectedPrice === 'premium' ? 'active' : '' %>" href="/listings?price=premium">₹7,000+</a></li>
        </ul>
    </div>

    <div class="tax-switch">
        <div class="form-check form-switch m-0">
            <input class="form-check-input" type="checkbox" id="taxSwitch">
            <label class="form-check-label ms-2" for="taxSwitch">
                Display total before taxes
            </label>
        </div>
    </div>

</div>
</div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of listings) { %>
        <a href="/listings/<%=listing._id%>" class="listings-link">
        <div class="card col listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="..." style="height:20rem">
            <div class="card-img-overlay"></div>
            <div class="card-body">
                <p class="card-text">
                  <b><%= listing.title %></b>
                <br>
            ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> / night
            <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
                </p>
            </div>
        </div>
        </a>
        <% } %>
        <% if (listings.length === 0) { %>
            <div class="col-12 mt-4">
                <p class="text-center text-muted">No properties found for this search.</p>
            </div>
        <% } %>
        </div>
    <!-- <form method ="GET" action="/listings/new">
        <button>Create New Listing</button>
    </form> -->